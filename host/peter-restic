#!/bin/bash
# Peter's restic window on pve01 (bmbell23/proxmox#7). Installed root-owned at /usr/local/sbin/peter-restic
# and reached only through the dispatcher's `restic` verb, via one sudoers line.
# Repos and sources are fixed here. No init, forget, prune, key or unlock: those stay Brandon's.
set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root

action="${1:-snapshots}"; repo="${2:-documents}"
case "$repo" in
  documents) src=/mnt/remote/boston/documents; share=/mnt/remote/boston ;;
  *)         echo "unknown repo: $repo (known: documents)" >&2; exit 126 ;;
esac
export RESTIC_REPOSITORY=/mnt/raid1/restic/$repo RESTIC_PASSWORD_FILE=/root/.restic/$repo.pass
scratch=/mnt/hdd/restore-test/$repo

# Long jobs run as transient units, so they outlive the ssh session; `log` reads them back.
bg() { systemd-run --quiet --collect --unit="peter-restic-$action-$repo" "$0" "run-$action" "$repo" \
         && echo "started peter-restic-$action-$repo; follow with: restic log $repo"; }

case "$action" in
  snapshots)  restic snapshots ;;
  stats)      restic stats --mode raw-data; restic stats ;;
  check)      restic check ;;
  backup|restore-test|check-data) bg ;;
  run-backup)
    ls "$src" >/dev/null || exit 1                                     # triggers the automount
    findmnt -no OPTIONS -t cifs "$share" | grep -q '^ro,' || { echo "$share is not mounted read-only; refusing" >&2; exit 1; }
    restic backup "$src" --tag "$repo" ;;
  run-restore-test)
    rm -rf "$scratch" && mkdir -p "$scratch"
    restic restore latest --tag "$repo" --target "$scratch" \
      && diff -rq "$src" "$scratch$src" && echo RESTORE-OK && rm -rf "$scratch" ;;
  run-check-data) restic check --read-data ;;
  log)
    systemctl list-units --all --no-pager --no-legend "peter-restic-*-$repo.service"
    journalctl --no-pager -o short-iso -n 40 -u "peter-restic-*-$repo.service" ;;
  *) echo "restic <snapshots|stats|check|backup|restore-test|check-data|log> [documents]" >&2; exit 126 ;;
esac
